# Copy to server/.env and fill in. Never commit .env.
# Quickest way to get the Neon values (after `neon login`), from the repo root:
#   npx neon-env export
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database: Neon (AWS us-east-1). Use the *pooled* connection string, e.g.
# postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon Auth (Neon console > Auth). Sign-up/sign-in happen in the browser;
# the server only verifies Neon's JWTs against these.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Western Verified scraper (npm run scrape:western -w server, or POST /api/verification/scrape as an admin).
# An email Western's Off-Campus Housing office can reach us at; it goes in the bot's User-Agent.
SCRAPER_CONTACT=
