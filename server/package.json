{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node src/index.ts",
    "migrate": "node --env-file=.env src/migrate.ts",
    "scrape:western": "node --env-file=.env src/verification/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "jose": "^6.2.17",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
